# Base URL of the Express API (built in Phase 5). Copy this file to .env
# and adjust if your backend runs on a different host/port.
VITE_API_URL=http://localhost:5000/api

# Optional: address used by the Contact page "Send via email" button
VITE_CONTACT_EMAIL=

# Optional: client-side ceiling for the image-upload/verification request (ms).
# Keep it LONGER than the server's VERIFICATION_TIMEOUT_MS so the server's clear 504 message wins.
VITE_VERIFY_TIMEOUT_MS=180000
