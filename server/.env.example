NODE_ENV=development
PORT=5000
MONGO_URI=

# Required in production (>= 32 random chars, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# Super admin: created/promoted by `npm run data:seed`. Password >= 10 chars. Stored only as a bcrypt hash.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Email OTP verification (any SMTP provider). Port 465 = implicit TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Processing limits (milliseconds). Safety ceilings so a wedged OCR worker cannot hang a request.
# OCR_TIMEOUT_MS bounds ONE Tesseract recognize() call; VERIFICATION_TIMEOUT_MS bounds the whole pipeline.
OCR_TIMEOUT_MS=45000
VERIFICATION_TIMEOUT_MS=150000
